POSTGRES_DB=smartcarbure
POSTGRES_USER=smartcarbure
POSTGRES_PASSWORD=change-me-local
# Service d'itinéraire OpenRouteService (trajet, F6)
# Clé personnelle et gratuite : https://account.heigit.org (à mettre seulement dans .env, jamais sur GitHub)
ITINERAIRE_API_URL=https://api.heigit.org
ITINERAIRE_API_KEY=

# Secret de signature des jetons JWT (au moins 32 caractères, à remplacer dans .env)
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire-d-au-moins-32-caracteres